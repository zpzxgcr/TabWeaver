{
  "manifest_version": 3,
  "name": "TabWeaver",
  "version": "2.1.4",
  "description": "纯网页端驱动的极速跨标签页浏览器自动化扩展（无需侧边栏与外部依赖）",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    },
    "default_title": "TabWeaver 控制中心",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://tongyi.aliyun.com/*",
        "https://tongyi.com/*",
        "https://www.tongyi.com/*",
        "https://chat.qwen.ai/*",
        "https://yuanbao.tencent.com/*",
        "https://yiyan.baidu.com/*",
        "https://wenxiaoyan.com/*",
        "https://www.wenxiaoyan.com/*",
        "https://xinghuo.xfyun.cn/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://chat.z.ai/*",
        "https://www.n.cn/*",
        "https://n.cn/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://hailuoai.com/*",
        "https://www.hailuoai.com/*",
        "https://yuewen.cn/*",
        "https://www.yuewen.cn/*",
        "https://ying.baichuan-ai.com/*"
      ],
      "js": ["platforms.js", "chat-dom.js", "content-chat.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "dom-distiller.js",
        "action-executor.js",
        "images/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
